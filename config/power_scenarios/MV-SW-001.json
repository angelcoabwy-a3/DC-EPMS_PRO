  "title": "Safe isolation of generator A3 for maintenance",
  "category": "MediumVoltage_Switching",
  "severity": "Critical",
  "tier_iv_relevance": true,
  "safety_critical": true,
  "description": "Forced sequence: open 52-G, open disconnector, verify absence of voltage, close earthing switch (two persons), apply LOTO (two persons). The path must keep its TOTAL load (IT + cooling + auxiliaries + UPS losses, at least 21.5 MW) in available generation (DC-EPMS-067).",
  "preconditions": {
    "path": "a",
    "generator": "genset_a_03",
    "engine": "STANDBY"
  },
  "sequence": [
    {
      "step": 1,
      "action": "authority",
      "target": "genset_a_03",
      "mode": "REMOTE"
    },
    {
      "step": 2,
      "action": "procedure",
      "target": "genset_a_03",
      "goal": "ISOLATE_FOR_MAINTENANCE"
    }
  ],
  "success_criteria": [
    {
      "check": "bay",
      "target": "genset_a_03",
      "cb": "OPEN",
      "ds": "OPEN",
      "es": "CLOSED",
      "loto": true
    },
    {
      "check": "path",
      "path": "a",
      "field": "gen_available",
      "equals": 8
    },
    {
      "check": "path",
      "path": "a",
      "field": "gen_available_kw",
      "equals": 22000
    },
    {
      "check": "path",
      "path": "a",
      "field": "gen_n_plus_1_ok",
      "equals": false
    }
  ],
  "audit": {
    "required_logging": [
      "user",
      "timestamp",
      "step",
      "result",
      "interlock_status"
    ]
  }
