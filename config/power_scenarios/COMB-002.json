{
  "scenario_id": "COMB-002",
  "version": "1.1.0",
  "title": "Utility loss on path A with two generators failing to start",
  "category": "Combined",
  "severity": "Critical",
  "tier_iv_relevance": true,
  "safety_critical": false,
  "description": "Seven of nine 2.75 MW sets reach the bus (19.25 MW). In normal 2N operation path A draws about 10.7 MW, so the transfer is permitted. Honest limit: the scenario does not model the utility outage itself or the battery ride-through.",
  "preconditions": {
    "path": "a",
    "generators_failed": [
      "genset_a_08",
      "genset_a_09"
    ]
  },
  "sequence": [
    {
      "step": 1,
      "action": "authority",
      "target": "mvtc_a",
      "mode": "REMOTE"
    },
    {
      "step": 2,
      "action": "authority",
      "target": "genset_a_*",
      "mode": "REMOTE"
    },
    {
      "step": 3,
      "action": "command",
      "targets": [
        "genset_a_01",
        "genset_a_02",
        "genset_a_03",
        "genset_a_04",
        "genset_a_05",
        "genset_a_06",
        "genset_a_07"
      ],
      "command": "START"
    },
    {
      "step": 4,
      "action": "advance",
      "seconds": 9
    },
    {
      "step": 5,
      "action": "command",
      "target": "mvtc_a",
      "command": "TRANSFER_TO_GENERATORS"
    }
  ],
  "success_criteria": [
    {
      "check": "device_state",
      "target": "mvtc_a",
      "equals": "GENERATORS"
    },
    {
      "check": "path",
      "path": "a",
      "field": "gen_on_bus_kw",
      "equals": 19250
    },
    {
      "check": "reading",
      "target": "genset_a_01",
      "label": "Load",
      "at_most": 100
    },
    {
      "check": "device_state",
      "target": "genset_a_08",
      "equals": "STANDBY"
    }
  ],
  "audit": {
    "required_logging": [
      "user",
      "timestamp",
      "step",
      "result",
      "interlock_status"
    ]
  }
}
