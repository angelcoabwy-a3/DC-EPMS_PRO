# ══════════════════════════════════════════════════════════════
#  DC-EPMS PRO — Environment Configuration
#  Copy this file to config/.env and fill in credentials.
#  Never commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ── Service ports ────────────────────────────────────────────
EPMS_HOST=0.0.0.0
EPMS_PORT=8080

# ── PostgreSQL / TimescaleDB ─────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=epms
PG_USER=postgres
PG_PASSWORD=epms2026

# ── ChromaDB ─────────────────────────────────────────────────
CHROMA_PATH=data/chroma_db

# ── LM Studio (local Gemma 4) ────────────────────────────────
# IMPORTANT: use 127.0.0.1 not localhost (IPv6 resolution fix on Windows)
LM_STUDIO_URL=http://127.0.0.1:1234

# ── Anthropic API (Claude Sonnet 4.6) ────────────────────────
ANTHROPIC_API_KEY=

# ── OpenRouter (optional, multi-model access) ────────────────
OPENROUTER_API_KEY=

# ── NVIDIA Riva ASR (WSL2) ───────────────────────────────────
RIVA_GRPC_URL=

# ── MCP shared secret ────────────────────────────────────────
MCP_SHARED_SECRET=

# ── Alert thresholds ─────────────────────────────────────────
PUE_ALERT_THRESHOLD=1.4
ASHRAE_A2_CRITICAL_TEMP_C=35.0

# ── Facility config ──────────────────────────────────────────
FACILITY_NAME=A3-Alpha Toronto Area
FACILITY_TIER=Tier IV 2N
OPERATOR_ORG=a3semi
FACILITY_MW=16.8
RACK_MODEL=NVIDIA GB200 NVL72
RACK_COUNT=118
RACK_TDP_KW=142
