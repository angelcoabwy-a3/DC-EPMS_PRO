"""
cmms_mcp.py — Paperclip orchestrator + CMMS work-order draft tool.

Lives alongside agent_copilot.py (v8.0). Adds a new MCP tool to the
registry: `draft_cmms_work_order`. Same draft-pattern guarantees as
the v8.0 tools — generates a Draft, never executes.

This module exists because the v8.0 `draft_precooling_plan` tool
addresses *immediate* setpoint actions, while CMMS work orders address
*scheduled maintenance* with a different lifecycle (LOR review, board
SLA, procedure attachment, contractor escalation). Different artifact,
different dispatch path, same audit gate.

Imports, FastAPI router boilerplate, and pydantic plumbing intentionally
omitted to focus on dispatch logic. Drop-in compatible with the v8.0
ToolRegistry and DraftStore.
"""

# ─── Constants from paperclip_org.yml (loaded at module init) ──────────
PAPERCLIP_ORG: dict   # populated by load_yaml("config/paperclip_org.yml")

# Cost thresholds and LOR-to-procedure mappings come from the YAML so
# operations can tune them without code change. Hardcoded defaults
# below are conservative fallbacks if the YAML is unavailable.
DEFAULT_COST_THRESHOLD_USD = 5000.0
DEFAULT_LOTO_LOR_THRESHOLD = 3


# ═══════════════════════════════════════════════════════════════════════
#  LOR (Level of Risk) computation
# ═══════════════════════════════════════════════════════════════════════
def compute_lor(
    likelihood_idx: int,        # 1..5
    consequence_idx: int,       # 1..5
    redundancy_mode: str,       # "2N" | "N+1" | "N"
) -> tuple[int, dict]:
    """Composite LOR score per Microsoft CO+I-style risk matrix.

    Returns (lor_int, breakdown_dict). The breakdown is attached to the
    work order so the board can see why this LOR was assigned.

    Math: LOR = clamp( (L × C) / 5 + redundancy_modifier , 1, 5 )

    The /5 normalisation collapses the 25-cell L×C matrix into the
    1..5 LOR scale. The redundancy modifier reflects a Tier IV truth:
    if you are already in N (one path failed), even a "low-risk"
    intervention carries higher risk because there is no fallback.
    """
    if not (1 <= likelihood_idx <= 5):
        raise ValueError(f"likelihood_idx out of range: {likelihood_idx}")
    if not (1 <= consequence_idx <= 5):
        raise ValueError(f"consequence_idx out of range: {consequence_idx}")

    redundancy_mod = {"2N": -1, "N+1": 0, "N": +1}.get(redundancy_mode, 0)
    raw = (likelihood_idx * consequence_idx) / 5.0
    lor = max(1, min(5, int(round(raw + redundancy_mod))))

    return lor, {
        "likelihood_idx": likelihood_idx,
        "consequence_idx": consequence_idx,
        "redundancy_mode": redundancy_mode,
        "redundancy_modifier": redundancy_mod,
        "raw_score": round(raw, 2),
        "lor_final": lor,
        "rationale": (
            f"L={likelihood_idx} × C={consequence_idx} = {raw:.1f} "
            f"normalised, then {redundancy_mod:+d} for {redundancy_mode} "
            f"redundancy → LOR {lor}"
        ),
    }


# ═══════════════════════════════════════════════════════════════════════
#  Procedure class selection — the SOP / MOP / DMOP / EOP decision
# ═══════════════════════════════════════════════════════════════════════
def select_procedure_class(
    work_class: str,            # "PM" | "CM" | "EM"
    lor: int,
    thermal_derivative_k_per_s: float | None,
    requires_loto: bool,
) -> str:
    """Pick exactly one procedure class. Decision tree, not an LLM call.

    Why deterministic: an LLM picking SOP vs DMOP would be a
    catastrophic failure mode (LOTO bypass via hallucination). This
    must be auditable code with literal IF/ELSE that a Tier IV
    auditor can read.

    Order of precedence (most restrictive wins):
      1. thermal_derivative critical → EOP
      2. requires_loto OR lor ≥ 3   → DMOP
      3. work_class == "EM"          → EOP
      4. work_class == "CM"          → MOP
      5. work_class == "PM"          → SOP
    """
    # Rule 1: thermal emergency overrides everything
    if thermal_derivative_k_per_s is not None:
        if abs(thermal_derivative_k_per_s) >= 0.5:
            return "EOP"

    # Rule 2: LOTO trumps work class for safety
    if requires_loto or lor >= DEFAULT_LOTO_LOR_THRESHOLD:
        return "DMOP"

    # Rule 3-5: work class determines default
    if work_class == "EM":
        return "EOP"
    if work_class == "CM":
        return "MOP"
    if work_class == "PM":
        return "SOP"

    # Defensive: unknown work_class → most restrictive
    return "DMOP"


# ═══════════════════════════════════════════════════════════════════════
#  THA (Task Hazard Analysis) generation
# ═══════════════════════════════════════════════════════════════════════
def generate_tha(
    component_id: str,
    procedure_class: str,
    lor: int,
    component_kind: str,        # "ups" | "chiller" | "rpp" | "cdu" | ...
) -> dict:
    """Construct a structured THA payload.

    The hazards list is rule-derived from component_kind + procedure_class.
    This is INTENTIONALLY not LLM-generated — THA omissions have caused
    deaths in the field, and a deterministic generator is auditable.

    The LLM's job is to *summarise* the THA for the board's review, not
    to author it.
    """
    base_hazards = {
        "ups":      ["arc_flash_cat_2", "stored_dc_energy", "battery_acid_exposure"],
        "chiller":  ["refrigerant_release_a2l", "rotating_equipment", "high_pressure_lines"],
        "rpp":      ["arc_flash_cat_3", "shock_277V_to_ground"],
        "cdu":      ["propylene_glycol_skin_contact", "rotating_equipment_pump"],
        "busway":   ["arc_flash_cat_2", "shock_480V_three_phase"],
        "xfmr":     ["arc_flash_cat_4", "induced_voltage", "oil_release"],
        "genset":   ["co_exposure", "high_temperature_exhaust", "fuel_release"],
    }
    component_kind_clean = component_kind.lower().split("_")[0]
    hazards = list(base_hazards.get(component_kind_clean, ["unknown_hazards_review_required"]))

    # DMOP/EOP add procedure-specific hazards
    if procedure_class == "DMOP":
        hazards.append("loto_isolation_verification_required")
        hazards.append("residual_energy_dissipation_check")
    if procedure_class == "EOP":
        hazards.append("time_pressure_decision_fatigue")
        hazards.append("post_event_review_mandatory")

    # PPE level scales with arc-flash category in hazards
    arc_flash_max_cat = 0
    for h in hazards:
        if "arc_flash_cat_" in h:
            cat = int(h.split("_cat_")[1])
            arc_flash_max_cat = max(arc_flash_max_cat, cat)

    ppe_level = {0: "minimum", 1: "category_1", 2: "category_2",
                 3: "category_3", 4: "category_4"}[arc_flash_max_cat]

    return {
        "component_id": component_id,
        "component_kind": component_kind,
        "procedure_class": procedure_class,
        "lor": lor,
        "hazards": hazards,
        "ppe_level": ppe_level,
        "two_person_rule_required": (procedure_class in ("DMOP", "EOP")) or lor >= 3,
        "standards": ["NFPA_70E", "CSA_Z462", "OSHA_1910_269"],
        "_authoring_method": "deterministic_rule_based",
        "_review_required_by": "operator_certified_qualified_electrical_worker",
    }


# ═══════════════════════════════════════════════════════════════════════
#  Contractor attachments — MSOW / EMPS decision
# ═══════════════════════════════════════════════════════════════════════
def determine_contractor_attachments(
    estimated_cost_usd: float,
    requires_oem_specialist: bool,
    procedure_class: str,
) -> dict:
    """Decide whether to attach MSOW (master agreement) and EMPS
    (task-specific procedure statement) for contractor work.

    Rules:
      - estimated_cost ≥ $5k OR requires_oem_specialist → attach EMPS
      - any contractor work → attach MSOW (always — it is the contract)
      - DMOP/EOP with contractor → both, plus pre-brief mandatory
    """
    needs_contractor = (
        estimated_cost_usd >= DEFAULT_COST_THRESHOLD_USD
        or requires_oem_specialist
    )
    if not needs_contractor:
        return {"contractor_required": False}

    return {
        "contractor_required": True,
        "msow_attached": True,
        "msow_doc_id": "DRAFT_MSOW_FROM_TEMPLATE",   # filled by board
        "emps_attached": True,
        "emps_doc_id": "DRAFT_EMPS_FROM_TEMPLATE",
        "pre_brief_required": procedure_class in ("DMOP", "EOP", "MOP"),
        "two_person_oversight": procedure_class in ("DMOP", "EOP"),
        "_note": (
            "MSOW/EMPS docs are TEMPLATES. The board fills in vendor, "
            "schedule, and final cost during approval. Drafts cannot "
            "commit contractual terms."
        ),
    }


# ═══════════════════════════════════════════════════════════════════════
#  The MCP tool — draft_cmms_work_order
# ═══════════════════════════════════════════════════════════════════════
